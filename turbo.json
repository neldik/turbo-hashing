{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["LOCAL_REGISTRY", "TURBO_BIN", "UV_*", "HOME", "PATH"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**", "pyproject.toml", "uv.lock", "README.md", "package.json",
        "!**/*.egg-info/**", "!**/__pycache__/**"
      ],
      "outputs": ["dist/**"],
      "env": ["VERSIONING_TAGS"]
    }
  }
}
